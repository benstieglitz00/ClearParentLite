@model ClearParentLite.Data.ApplicationUser
@{ ViewData["Title"]="Settings"; }
<div class="narrow"><h1>Settings</h1><section class="card"><h2>Your profile</h2><p>@Model.Email <span class="badge">@(Model.EmailConfirmed?"Verified":"Unverified")</span></p><form method="post">@Html.AntiForgeryToken()<label for="displayName">Display name</label><input id="displayName" name="displayName" value="@Model.DisplayName" maxlength="100" required /><div class="actions"><button class="primary">Save profile</button><a href="/account/forgot-password">Reset password</a></div></form></section><section class="card"><h2>Shared with you</h2>@foreach(var s in (List<ClearParentLite.Data.ShareGrant>)ViewBag.Received){<p><a href="/shared/@s.Id">View shared @(s.Scope==ClearParentLite.Data.ShareScope.Timeline?"timeline":"entries") →</a><small>Expires @s.ExpiresUtc?.ToString("MMM d, yyyy HH:mm 'UTC'")</small></p>}</section><section class="card prose"><h2>Your data</h2><p>You can export your records from Exports. Removing an entry hides it from the timeline and shares; stored revisions and files are retained. Contact the deployment operator for permanent account deletion and backup retention details.</p><a href="/Home/Privacy">Read the privacy information</a></section>@if(User.IsInRole("Administrator")){<a href="/admin/users">Manage users</a>}</div>
