@model EntryDetail
@{ ViewData["Title"]=Model.Entry.Title; var e=Model.Entry; }
<div class="narrow"><a href="@(Model.IsOwner?"/timeline":"/settings")" class="back">← Back</a><div class="page-heading"><div><span class="eyebrow">@(Model.IsOwner?"Timeline entry":"Shared · read only")</span><h1>@e.Title</h1><p class="event-date">Occurred on @e.EventDate.ToString("MMMM d, yyyy")</p></div>@if(Model.IsOwner){<a class="button" href="/entries/@e.Id/edit">Edit entry</a>}</div>
<div class="audit-dates">Recorded on @e.CreatedUtc.ToString("MMM d, yyyy HH:mm 'UTC'") · Edited on @e.UpdatedUtc.ToString("MMM d, yyyy HH:mm 'UTC'")</div>
<article class="card prose">@Html.Raw(e.DescriptionHtml)</article>
<section class="card"><h2>Attachments <span class="count">@e.Attachments.Count(a=>!a.IsDeleted)</span></h2><ul class="file-list">@foreach(var a in e.Attachments.Where(a=>!a.IsDeleted)){<li><a href="/attachments/@a.Id">↗ @a.OriginalFileName</a><small>@((a.ByteLength/1024.0).ToString("N1")) KB</small></li>}</ul>
@if(Model.IsOwner){<form method="post" action="/entries/@e.Id/attachments" enctype="multipart/form-data">@Html.AntiForgeryToken()<label for="file">Add a file</label><input type="file" name="file" id="file" required accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.doc,.docx" /><button>Upload</button></form>}</section>
<section><h2>Updates</h2>@foreach(var update in e.Updates.Where(u=>!u.IsDeleted).OrderBy(u=>u.CreatedUtc).ThenBy(u=>u.Id)){<article class="card update"><time>@update.CreatedUtc.ToString("MMM d, yyyy HH:mm 'UTC'")</time><div class="prose">@Html.Raw(update.BodyHtml)</div></article>}
@if(Model.IsOwner){<form method="post" action="/entries/@e.Id/updates" class="card" data-entry-form data-entry-id="@e.Id">@Html.AntiForgeryToken()<label for="BodyHtml">Add a timestamped update</label><textarea id="BodyHtml" name="bodyHtml" data-editor></textarea><small>Updates are append-only.</small><button class="primary">Add update</button></form>}</section>
@if(Model.IsOwner){<section class="card"><details><summary>Revision history · @e.Revisions.Count versions</summary>@foreach(var r in e.Revisions.OrderByDescending(r=>r.RevisionNumber)){<article class="revision"><h3>Version @r.RevisionNumber · @r.Title</h3><small>Edited @r.EditedUtc.ToString("MMM d, yyyy HH:mm 'UTC'") · Occurred @r.EventDate.ToString("MMM d, yyyy")</small><p>@r.ChangeReason</p><div class="prose">@Html.Raw(r.DescriptionHtml)</div></article>}</details></section><div class="actions"><a class="button" href="/shares">Share entries</a><a class="button" href="/exports?selected=@e.Id">Export this entry</a><form method="post" action="/entries/@e.Id/delete" data-confirm="Remove this entry from your timeline and all shares?">@Html.AntiForgeryToken()<button class="danger">Remove entry</button></form></div>}
</div>
