@model TimelinePage
@{ ViewData["Title"]="Your timeline"; }
<div class="page-heading"><div><span class="eyebrow">Your private workspace</span><h1>Parenting timeline</h1><p class="muted">The details that matter, all in one place.</p></div><a href="/entries/new" class="button primary" data-new-entry>＋ New entry <kbd>N</kbd></a></div>
<form method="get" class="filters card"><label>Search<input name="q" value="@Model.Q" placeholder="Search entries and updates…" maxlength="200" /></label><label>From<input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" /></label><label>To<input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" /></label><button>Filter</button><a href="/timeline">Clear</a></form>
<section class="timeline card" aria-label="Timeline entries"><div class="list-heading"><span>Event</span><span>Occurred on</span></div>
@if(Model.Entries.Count==0){<div class="empty"><span class="empty-icon">◎</span><h2>A clearer picture starts with one entry</h2><p>Record an event, save the details, and build your timeline at your own pace.</p><a href="/entries/new" class="button primary" data-new-entry>Create an entry</a></div>}
@foreach(var entry in Model.Entries){<a class="timeline-row" href="/entries/@entry.Id"><span><strong>@entry.Title</strong><small>@entry.UpdateCount @(entry.UpdateCount==1?"update":"updates") · @entry.AttachmentCount @(entry.AttachmentCount==1?"file":"files") @(entry.UpdatedUtc>entry.CreatedUtc.AddSeconds(1)?" · modified":"")</small></span><time datetime="@entry.EventDate.ToString("yyyy-MM-dd")">@entry.EventDate.ToString("MMM d, yyyy")</time></a>}
</section><nav class="pagination" aria-label="Pagination">@if(Model.Page>1){<a href="@Url.Action("Index",new {page=Model.Page-1,q=Model.Q,from=Model.From?.ToString("yyyy-MM-dd"),to=Model.To?.ToString("yyyy-MM-dd")})">← Previous</a>}<span>Page @Model.Page</span>@if(Model.HasMore){<a href="@Url.Action("Index",new {page=Model.Page+1,q=Model.Q,from=Model.From?.ToString("yyyy-MM-dd"),to=Model.To?.ToString("yyyy-MM-dd")})">Next →</a>}</nav>
