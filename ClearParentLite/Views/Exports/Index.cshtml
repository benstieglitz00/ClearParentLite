@model List<ClearParentLite.Data.TimelineEntry>
@{ ViewData["Title"]="Export your timeline"; }
<div class="narrow"><span class="eyebrow">Your records, ready to take with you</span><h1>Export your timeline</h1><p class="muted">Create a readable PDF, or a ZIP with the report, original files, and checksum manifest.</p><form method="post" class="card">@Html.AntiForgeryToken()<label for="scope">Records to include</label><select id="scope" name="scope"><option value="@(ViewBag.Selected!=null?"selected":"all")">@(ViewBag.Selected!=null?"Selected entries":"Entire timeline")</option><option value="selected">Selected entries</option><option value="dates">Event date range</option><option value="all">Entire timeline</option></select><div class="filters"><label>From<input name="from" type="date" /></label><label>To<input name="to" type="date" /></label></div><fieldset><legend>Entries for selected export</legend>@foreach(var e in Model){<label class="check"><input type="checkbox" name="entryIds" value="@e.Id" checked="@(ViewBag.Selected!=null && (Guid)ViewBag.Selected==e.Id)" /><span>@e.Title<small>@e.EventDate.ToString("MMM d, yyyy")</small></span></label>}</fieldset><label for="format">Format</label><select name="format" id="format"><option value="pdf">PDF report</option><option value="zip">ZIP: report + original attachments + manifest</option></select><p class="notice">Exports contain private information. Store and share them securely. Maximum 500 entries, 2 million text characters and 250 MB of attachments per export. Dates are inclusive and apply only to date-range exports.</p><button class="primary">Download export</button></form></div>
