@model SharesPage
@{ ViewData["Title"]="Sharing"; }
<div class="page-heading"><div><span class="eyebrow">Choose what to share</span><h1>Sharing</h1><p class="muted">Give someone a read-only view. Revoke access whenever you need.</p></div></div>
<div class="two-column"><section class="card"><h2>Create a share</h2><form method="post" action="/shares" data-scope-options>@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div>
<label for="Scope">Scope</label><select id="Scope" name="Scope"><option value="SelectedEntries" selected="@(Model.Input.Scope==ClearParentLite.Data.ShareScope.SelectedEntries)">Selected entries</option><option value="Timeline" selected="@(Model.Input.Scope==ClearParentLite.Data.ShareScope.Timeline)">Full timeline (including future entries)</option></select>
<fieldset data-selected-records><legend>Entries for a selected share</legend>@foreach(var e in Model.Entries){<label class="check"><input type="checkbox" name="EntryIds" value="@e.Id" checked="@Model.Input.EntryIds.Contains(e.Id)" /><span>@e.Title <small>@e.EventDate.ToString("MMM d, yyyy")</small></span></label>}</fieldset>
<label for="AccessMethod">Access method</label><select id="AccessMethod" name="AccessMethod"><option value="Invitation" selected="@(Model.Input.AccessMethod==ClearParentLite.Data.ShareMethod.Invitation)">Invitation to a verified email account</option><option value="Link" selected="@(Model.Input.AccessMethod==ClearParentLite.Data.ShareMethod.Link)">Anyone with the link</option></select><div data-invitation-email><label for="Email">Recipient email (invitations)</label><input type="email" id="Email" name="Email" value="@Model.Input.Email" /></div>
<label for="Days">Expires after (days)</label><input id="Days" name="Days" type="number" min="1" max="90" value="@Model.Input.Days" required /><p class="notice" data-link-warning>Anyone holding a share link can view the included entries and download their attachments until it expires or you revoke it. Share carefully.</p><button class="primary">Create read-only share</button></form></section>
<section class="card"><h2>Manage access</h2>@if(Model.Grants.Count==0){<p class="muted">No active or past shares yet.</p>}@foreach(var s in Model.Grants){<article class="grant"><strong>@(s.AccessMethod==ClearParentLite.Data.ShareMethod.Link?"Read-only link":s.InvitedEmailNormalized)</strong><small>@(s.Scope==ClearParentLite.Data.ShareScope.Timeline?"Full timeline":"Selected entries") · @(s.Scope==ClearParentLite.Data.ShareScope.SelectedEntries?$"{s.Entries.Count} {(s.Entries.Count==1?"entry":"entries")}":"all current and future entries")</small><small>Expires @s.ExpiresUtc?.ToString("MMM d, yyyy HH:mm 'UTC'")</small>@if(s.RevokedUtc!=null){<span class="badge">Revoked</span>}else if(s.ExpiresUtc<=DateTime.UtcNow){<span class="badge">Expired</span>}else{<form method="post" action="/shares/@s.Id/revoke">@Html.AntiForgeryToken()<button class="danger">Revoke access</button></form>}</article>}</section></div>
