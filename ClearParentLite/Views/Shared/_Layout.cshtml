@{
    var signedIn=User.Identity?.IsAuthenticated==true;
}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · ClearParent Lite</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/lib/quill/quill.snow.css" /><link rel="stylesheet" href="~/css/accessibility.css" asp-append-version="true" /></head>
<body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/"><span class="brand-mark">c</span>ClearParent <span class="lite">lite</span></a><nav aria-label="Main navigation"><a href="/">Home</a><a href="/resources">Resources</a>@if(signedIn){<a href="/timeline">Timeline</a><a href="/shares">Sharing</a><a href="/exports">Exports</a><a href="/settings">Settings</a><form method="post" action="/account/logout">@Html.AntiForgeryToken()<button class="text-button">Sign out</button></form>}else{<a href="/account/login">Log in</a><a href="/account/register" class="button primary small">Get started</a>}</nav></header>
<div class="app-shell">@if(signedIn){<aside class="sidebar"><span class="workspace-label">PERSONAL WORKSPACE</span><a href="/timeline">&#9677; &nbsp; Timeline</a><a href="/shares">&#8599; &nbsp; Sharing</a><a href="/exports">&#8595; &nbsp; Exports</a><a href="/settings">&#9881; &nbsp; Settings</a><div class="sidebar-note">A clearer record.<br />A little more peace of mind.</div></aside>}<main id="main" class="@(signedIn?"workspace":"public-main")">@if(TempData["Notice"] is string notice){<div class="notice" role="status">@notice</div>}@RenderBody()</main></div>
<footer>ClearParent Lite <span>Thoughtful documentation for everyday parenting.</span><a href="/Home/Privacy">Privacy</a></footer><dialog id="entry-dialog" aria-label="New timeline entry"><button type="button" class="dialog-close" aria-label="Close new entry">×</button><div data-dialog-content></div></dialog>
<script src="~/lib/quill/quill.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
