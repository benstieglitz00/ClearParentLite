@model ResetInput
@{ ViewData["Title"]="Choose a new password"; }
<section class="auth card"><h1>Choose a new password</h1><form method="post"><div asp-validation-summary="All" class="validation"></div><input asp-for="Code" type="hidden" /><label asp-for="Email"></label><input asp-for="Email" /><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><button class="primary">Reset password</button></form></section>
